<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DNS Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
     <link rel="stylesheet" href="/css/styles.css">

</head>
<body class="bg-gray-100 text-gray-100">
    <div class="container mx-auto   shadow-2xl  px-10 mt-8   text-center">
        <h1 class="text-4xl font-extrabold font-sans h-12 w-auto text-white  underline underline-offset-auto   mb-14">DNS MANAGEMENT SYSTEM</h1>
      <span class="w-screen h-screen"><img src="/css/home.jpg" class="object-fill w-screen h-96 z-0" alt=""></span>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 pt-5 pb-4 z-10">
            <!-- Add Record Button -->
            <a href="/add" class="block bg-blue-500 text-white font-medium py-3 px-6 rounded-lg hover:bg-blue-600 transition">
                Add Record
            </a>

            <!-- Search Record Button -->
            <a href="/search" class="block bg-green-500 text-white font-medium py-3 px-6 rounded-lg hover:bg-green-600 transition">
                Search Record
            </a>

            <!-- View All Records Button -->
            <a href="/view-all" class="block bg-yellow-500 text-white font-medium py-3 px-6 rounded-lg hover:bg-yellow-600 transition">
                View All Records
            </a>

            <!-- Delete Record Button -->
            <a href="/delete" class="block bg-red-500 text-white font-medium py-3 px-6 rounded-lg hover:bg-red-600 transition">
                Delete Record
            </a>
        </div>
    </div>
</body>
</html>

