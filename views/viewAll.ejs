<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View All Records</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/view-all.css">

  <!-- Add Font Awesome for icons -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

</head>
<body>
  <div class="container mt-5 ">
    <h1 class="mb-4 text-center">All Records</h1>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>DNS</th>
          <th>IP</th>
          <th>Class</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% records.forEach(record => { %>
          <tr>
            <td><%= record.dns %></td>
            <td><%= record.ip %></td>
            <td><%= record.class %></td>
            <td>

              <!-- Update icon -->
              <form action="/update/<%= record._id %>" method="GET" style="display:inline;">
                <button type="submit" class="icon-button edit-btn">
                  <i class="fas fa-edit"></i>
                </button>
              </form>

              <!-- Delete icon -->
              <form action="/delete/<%= record._id %>" method="POST" style="display:inline;">
                <button type="submit" class="icon-button delete-btn" onclick="return confirm('Are you sure you want to delete this record?')">
                  <i class="fas fa-trash-alt"></i>
                </button>
              </form>

            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    
    <a href="/" class="btn btn-secondary mt-3">Go Back</a>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
